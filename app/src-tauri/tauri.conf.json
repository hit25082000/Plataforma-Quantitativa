{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plataforma Quantitativa",
  "version": "0.1.0",
  "identifier": "com.plataforma.quantitativa",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../frontend && npm run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Plataforma Quantitativa",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8000 http://localhost:8000 ws://127.0.0.1:8000 ws://localhost:8000 http://127.0.0.1:5558 http://localhost:5558 ws://127.0.0.1:5558 ws://localhost:5558; media-src 'self' asset: https://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "capabilities": [
        {
          "identifier": "app-default",
          "description": "Permissões padrão do app (config, invoke, recursos)",
          "windows": [
            "*"
          ],
          "permissions": [
            "core:default"
          ]
        },
        {
          "identifier": "window-drag-close",
          "description": "Permite arrastar e fechar janelas (principal e widgets)",
          "windows": [
            "*"
          ],
          "permissions": [
            "core:window:allow-close",
            "core:window:allow-start-dragging"
          ]
        },
        {
          "identifier": "overlay-window-control",
          "description": "Permissões para criar e controlar janela de overlay transparente",
          "windows": [
            "*"
          ],
          "permissions": [
            "core:window:allow-create",
            "core:window:allow-show",
            "core:window:allow-hide",
            "core:window:allow-set-always-on-top",
            "core:window:allow-set-ignore-cursor-events",
            "core:webview:allow-create-webview-window"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Plataforma Quantitativa",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "resources": [
      "resources/profit_ocr_service.py",
      "resources/ocr_overlay_audit.py",
      "resources/profit_ocr_service.exe",
      "resources/engine.exe",
      "resources/distributor.exe",
      "resources/ProfitDLL.dll",
      "resources/ProfitDLL64.dll",
      "resources/libzmq-mt-4_3_5.dll",
      "resources/sounds/wall.wav",
      "resources/sounds/breakout.wav"
    ],
    "shortDescription": "Plataforma de análise de microestrutura B3",
    "longDescription": "Plataforma desktop de análise de microestrutura de mercado (B3): processa livro de ofertas e fluxo de ordens em tempo real, disparando alertas táticos baseados em 5 regras quantitativas."
  },
  "plugins": {}
}