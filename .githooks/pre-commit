#!/bin/sh
set -eu

ROOT="$(git rev-parse --show-toplevel)"

if command -v python >/dev/null 2>&1; then
  python "$ROOT/scripts/scan_secrets.py" --staged
  exit $?
fi

if command -v py >/dev/null 2>&1; then
  py -3 "$ROOT/scripts/scan_secrets.py" --staged
  exit $?
fi

echo "Python nao encontrado para executar secret scan." >&2
exit 1
